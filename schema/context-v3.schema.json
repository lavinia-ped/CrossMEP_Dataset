{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/USER/crossmep/schema/context-v3.json",
  "title": "CrossMEP dataset file",
  "type": "object",
  "required": ["dataset", "version", "split", "seed", "n_contexts", "units", "contexts"],
  "properties": {
    "dataset": { "const": "CrossMEP" },
    "version": { "type": "string", "pattern": "^3\\." },
    "split": { "enum": ["train", "val", "test", "benchmark"] },
    "seed": { "type": "integer" },
    "n_contexts": { "type": "integer", "minimum": 1 },
    "units": { "const": "mm, kN" },
    "contexts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["context_id", "tier", "surface", "n_elements", "n_levels",
                     "total_load_kN", "bundle_width_mm", "elements"],
        "properties": {
          "context_id": { "type": "string" },
          "tier": { "enum": ["C1","C2","C3","C4","C5","C6","C7","C8","custom"] },
          "surface": {
            "type": "object",
            "required": ["kind", "substrate", "thickness_mm"],
            "properties": {
              "kind": { "enum": ["ceiling", "wall"] },
              "substrate": { "type": "string" },
              "thickness_mm": { "type": "number", "exclusiveMinimum": 0 }
            }
          },
          "n_elements": { "type": "integer", "minimum": 1, "maximum": 12 },
          "n_levels": { "type": "integer", "minimum": 1, "maximum": 3 },
          "total_load_kN": { "type": "number", "exclusiveMinimum": 0 },
          "bundle_width_mm": { "type": "number", "exclusiveMinimum": 0 },
          "elements": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind", "service", "trade", "shape", "label", "width_mm",
                           "height_mm", "insulation_mm", "load_kN", "level",
                           "along_mm", "out_mm"],
              "properties": {
                "kind": { "enum": ["pipe", "cable_tray", "duct", "conduit"] },
                "service": { "type": "string" },
                "trade": { "enum": ["domestic", "heating", "chilled", "sprinkler",
                                     "electrical", "ventilation"] },
                "shape": { "enum": ["round", "rect"] },
                "label": { "type": "string" },
                "width_mm": { "type": "number", "exclusiveMinimum": 0 },
                "height_mm": { "type": "number", "exclusiveMinimum": 0 },
                "insulation_mm": { "type": "number", "minimum": 0 },
                "load_kN": { "type": "number", "exclusiveMinimum": 0 },
                "level": { "type": "integer", "minimum": 0, "maximum": 2 },
                "along_mm": { "type": "number" },
                "out_mm": { "type": "number", "exclusiveMinimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}

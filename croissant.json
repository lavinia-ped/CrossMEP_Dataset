  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "contexts",
      "name": "contexts",
      "description": "One record per MEP cross-section context (schema/context-v4.schema.json). Units: mm, kN, m.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "contexts/context_id",
          "name": "context_id",
          "dataType": "sc:Text"
        },
        {
          "@type": "cr:Field",
          "@id": "contexts/tier",
          "name": "tier",
          "dataType": "sc:Text",
          "description": "C1..C8 = exact element count"
        },
        {
          "@type": "cr:Field",
          "@id": "contexts/surface_kind",
          "name": "surface.kind",
          "dataType": "sc:Text",
          "description": "ceiling | wall"
        },
        {
          "@type": "cr:Field",
          "@id": "contexts/surface_substrate",
          "name": "surface.substrate",
          "dataType": "sc:Text"
        },
        {
          "@type": "cr:Field",
          "@id": "contexts/surface_thickness_mm",
          "name": "surface.thickness_mm",
          "dataType": "sc:Float"
        },
        {
          "@type": "cr:Field",
          "@id": "contexts/n_elements",
          "name": "n_elements",
          "dataType": "sc:Integer"
        },
        {
          "@type": "cr:Field",
          "@id": "contexts/n_levels",
          "name": "n_levels",
          "dataType": "sc:Integer"
        },
        {
          "@type": "cr:Field",
          "@id": "contexts/total_load_kN",
          "name": "total_load_kN",
          "dataType": "sc:Float"
        },
        {
          "@type": "cr:Field",
          "@id": "contexts/bundle_width_mm",
          "name": "bundle_width_mm",
          "dataType": "sc:Float",
          "description": "physical overall extent along the surface, insulation included"
        },
        {
          "@type": "cr:Field",
          "@id": "contexts/elements",
          "name": "elements",
          "dataType": "sc:Text",
          "description": "array of elements: kind, service, trade, shape, label, width_mm, height_mm, insulation_mm, load_kN, span_m, load_kN_per_m, level, along_mm, out_mm (revision 3.0 files omit span_m and load_kN_per_m)",
          "repeated": true
        }
      ]
    }
  ]
}

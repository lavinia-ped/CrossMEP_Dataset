      "sha256": "ea6f5ccd40843fb674b145e2cd22310705c455b990ae0ebbcc4a285998f12cfb"
    },
    {
      "@type": "cr:FileObject",
      "@id": "val",
      "name": "mep_contexts_v3.0_val.json",
      "contentUrl": "mep_contexts_v3.0_val.json",
      "encodingFormat": "application/json",
      "sha256": "9920877a489b57fe194cb4babdf0e5db2c831eb65629ddd2b3db24e1816bb9e9"
    },
    {
      "@type": "cr:FileObject",
      "@id": "test",
      "name": "mep_contexts_v3.0_test.json",

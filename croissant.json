  "@type": "sc:Dataset",
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "CrossMEP",
  "description": "Tiered synthetic dataset of multi-trade MEP cross-sections for learning-based structural support assembly synthesis. 7,000 contexts across train/val/test/benchmark splits on disjoint seeds; tiers C1-C8 by exact element count; deliberately unlabeled (supervision from downstream environment rules). Data revision 3.0; release 3.5.0.",
  "version": "3.5.0",
  "datePublished": "2026-10-03",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "url": "https://github.com/lavinia-ped/CrossMEP_Dataset",
  "citeAs": "Pedrollo, L., Gvadzabia, D., Graeber, T. & Fischer, M. (2026). CrossMEP: A Tiered Synthetic Dataset of Multi-Trade MEP Cross-Sections. 43rd International CIB W78 Conference, New Delhi.",
  "creator": [
    { "@type": "sc:Person", "name": "Lavinia Pedrollo", "affiliation": "Stanford University" },
    { "@type": "sc:Person", "name": "David Gvadzabia", "affiliation": "Lafayette College" },
    { "@type": "sc:Person", "name": "Torben Graeber", "affiliation": "Hilti AG" },
    { "@type": "sc:Person", "name": "Martin Fischer", "affiliation": "Stanford University" }
  ],
  "keywords": ["MEP", "structural support assembly", "synthetic dataset", "BIM", "reinforcement learning"],
  "distribution": [
    {

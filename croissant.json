      "contentUrl": "mep_contexts_v3.0_benchmark.json",
      "encodingFormat": "application/json",
      "sha256": "ecf4cbd2bb46e49e3a297aa2f3dff688b2de708cbd9ee2fe85fd5626a29e8ac1"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "contexts",
      "name": "contexts",
      "description": "One record per MEP cross-section context (schema/context-v3.schema.json). Units: mm, kN.",
      "field": [
        { "@type": "cr:Field", "@id": "contexts/context_id", "name": "context_id", "dataType": "sc:Text" },
        { "@type": "cr:Field", "@id": "contexts/tier", "name": "tier", "dataType": "sc:Text",
          "description": "C1..C8 = exact element count" },
        { "@type": "cr:Field", "@id": "contexts/surface_kind", "name": "surface.kind", "dataType": "sc:Text",
          "description": "ceiling | wall" },
        { "@type": "cr:Field", "@id": "contexts/surface_substrate", "name": "surface.substrate", "dataType": "sc:Text" },
        { "@type": "cr:Field", "@id": "contexts/surface_thickness_mm", "name": "surface.thickness_mm", "dataType": "sc:Float" },
        { "@type": "cr:Field", "@id": "contexts/n_elements", "name": "n_elements", "dataType": "sc:Integer" },
        { "@type": "cr:Field", "@id": "contexts/n_levels", "name": "n_levels", "dataType": "sc:Integer" },
        { "@type": "cr:Field", "@id": "contexts/total_load_kN", "name": "total_load_kN", "dataType": "sc:Float" },
        { "@type": "cr:Field", "@id": "contexts/bundle_width_mm", "name": "bundle_width_mm", "dataType": "sc:Float" },
        { "@type": "cr:Field", "@id": "contexts/elements", "name": "elements", "dataType": "sc:Text",
          "description": "array of elements: kind, service, trade, shape, label, width_mm, height_mm, insulation_mm, load_kN, level, along_mm, out_mm",
          "repeated": true }
      ]
    }
  ]
}

    },
    {
      "@type": "sc:Person",
      "name": "Martin Fischer",
      "affiliation": "Stanford University"
    }
  ],
  "keywords": [
    "MEP",
    "structural support assembly",
    "synthetic dataset",
    "BIM",
    "reinforcement learning"
  ],
